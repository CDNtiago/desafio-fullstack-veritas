---
config:
  theme: base
  themeVariables:
    primaryColor: '#f4ead9'
    primaryTextColor: '#02141b'
    primaryBorderColor: '#9f835a'
    lineColor: '#526c76'
    secondaryColor: '#e4eeed'
    tertiaryColor: '#f6f7f5'
    fontFamily: 'Arial, sans-serif'
    fontSize: '16px'
---
flowchart TB
    A([Abrir ou recarregar o Mini Kanban]) --> B[Carregar tarefas]
    B --> C{Carregou?}
    C -- Não --> D[Mostrar erro e Tentar novamente]
    D --> B
    C -- Sim --> E[Exibir quadro, inclusive vazio<br/>A Fazer · Em Progresso · Concluídas]
    E --> F{Escolher ação}

    subgraph FORM[Criação e edição]
      direction TB
      G[Nova tarefa ou Editar] --> I[Preencher título,<br/>descrição opcional e status]
      I -- Cancelar --> FC([Voltar ao quadro])
      I -- Salvar --> J{Dados válidos?}
      J -- Não --> K[Mostrar validação<br/>Preservar campos]
      K --> I
      J -- Sim --> L[Aguardar salvamento]
      L --> R{Salvou?}
      R -- Não --> T[Mostrar erro e preservar formulário<br/>Conferir estado salvo antes de reenviar]
      T --> I
      R -- Sim --> FS([Ver tarefa no quadro<br/>e mensagem de sucesso])
    end

    subgraph MOVE[Movimentação]
      direction TB
      M[Arrastar o cartão<br/>ou escolher status] --> N{Confirmar destino?}
      N -- Cancelar arraste --> MC([Voltar ao quadro])
      N -- Sim --> O[Aguardar salvamento<br/>Todas as transições são permitidas]
      O --> P{Salvou?}
      P -- Não --> Q[Reverter movimento<br/>Mostrar erro e recarregar dados]
      Q --> MF([Conferir quadro antes<br/>de tentar novamente])
      P -- Sim --> MS([Ver cartão na coluna<br/>e mensagem de sucesso])
    end

    subgraph DELETE[Exclusão]
      direction TB
      X[Clicar em Excluir] --> Y{Confirmar exclusão?}
      Y -- Cancelar --> DC([Voltar ao quadro])
      Y -- Excluir --> Z[Aguardar exclusão]
      Z --> W{Excluiu?}
      W -- Não --> V[Mostrar erro e manter confirmação<br/>Conferir estado salvo antes de reenviar]
      V --> Y
      W -- Sim --> DS([Ver quadro sem a tarefa<br/>e mensagem de sucesso])
    end

    F --> G
    F --> M
    F --> X
